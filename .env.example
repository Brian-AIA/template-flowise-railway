# Railway asigna PORT automáticamente. Este valor solo documenta el puerto de Flowise.
PORT=3000

# Base de datos PostgreSQL administrada por Railway. El servicio debe llamarse "Postgres".
DATABASE_TYPE=postgres
DATABASE_HOST=${{Postgres.PGHOST}}
DATABASE_PORT=${{Postgres.PGPORT}}
DATABASE_NAME=${{Postgres.PGDATABASE}}
DATABASE_USER=${{Postgres.PGUSER}}
DATABASE_PASSWORD=${{Postgres.PGPASSWORD}}

# Se genera un secreto distinto al desplegar desde una plantilla de Railway.
FLOWISE_SECRETKEY_OVERWRITE=${{secret(64)}}

# Conserva ejecuciones durante 90 días; las terminales más antiguas se eliminan cada día a las 03:15.
EXECUTION_RETENTION_ENABLED=true
EXECUTION_RETENTION_DAYS=90
EXECUTION_RETENTION_CRON=15 3 * * *
EXECUTION_RETENTION_TIMEZONE=Europe/Madrid
EXECUTION_RETENTION_BATCH_SIZE=250
EXECUTION_RETENTION_MAX_DELETIONS_PER_RUN=10000
